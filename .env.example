# Generado automáticamente por scripts/start-all.sh si no existe.
# Emulador Android : no hace falta cambiar DEV_HOST (usa 10.0.2.2:5050 automáticamente).
# Celular físico   : pon la IP LAN de la Mac donde corre el backend (ej. 192.168.1.160).
# Remoto DuckDNS   : define EXPO_PUBLIC_API_URL para override completo.

EXPO_PUBLIC_DEV_HOST=192.168.1.160

# Override opcional para DuckDNS/producción (incluye protocolo, sin barra al final)
# EXPO_PUBLIC_API_URL=https://signtrack-kinal.duckdns.org

# URL LiveKit (solo si difiere de la default derivada de API_URL)
# EXPO_PUBLIC_LIVEKIT_URL=wss://signtrack-kinal.duckdns.org/livekit

# No definas AUTH_URL/API_BASE salvo que sepas lo que haces;
# env.js construye las URLs automáticamente según plataforma y entorno.
